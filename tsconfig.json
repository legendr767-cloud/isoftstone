{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests/web"]
}
