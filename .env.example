# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=4000

# ---- Database (PostgreSQL) ----
# Use the pooled connection string from your provider (sslmode=require for hosted databases)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Security (generate with: openssl rand -hex 32) ----
SESSION_SECRET=replace-with-64-hex-chars
PAYMENT_WEBHOOK_SECRET=replace-with-64-hex-chars

# ---- Payments ----
# "none" (default) = checkout creates orders but cannot take payment.
# "dev_simulator" = DEVELOPMENT/PREVIEW ONLY signed-webhook simulator.
PAYMENT_PROVIDER=none
ALLOW_PAYMENT_SIMULATOR=false

# ---- Trading provider ----
# "none" (default) | "demo" (development fixtures only; refused in production)
TRADING_PROVIDER=none

# ---- Email ----
# "none" logs to server console in development only. Configure a real provider to deliver mail.
EMAIL_PROVIDER=none         # none | resend
# RESEND_API_KEY=          # required when EMAIL_PROVIDER=resend (and a verified sending domain in EMAIL_FROM)
EMAIL_FROM=iSoftStone <no-reply@example.com>

# ---- Brand / contact (non-secret; exposed through /api/v1/site) ----
SUPPORT_EMAIL=            # public support address; leave empty to hide it
# DATABASE_CA=             # optional PEM of your database CA to enable full TLS verification

# ---- Admin provisioning (used ONLY by `npm run admin:create`; never commit real values) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
